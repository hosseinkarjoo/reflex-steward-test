# steward-arch.toml — Architectural state managed by Steward MCP tools.
# Do not edit manually. Use MCP write tools (write_layer_assignments, write_flow_rules, etc.)
# Restore previous state: steward undo
# Archetype: layered — General-purpose layered architecture (Entry / Interface / Core / Storage / Output / Internal)

[layers]
# Maps source files to named architectural layers.
# Key: path relative to steward.toml. Value: layer name (4-6 distinct names recommended).
# Example:
#   "src/reflex/cli.py"       = "Entry"     # user-facing entry points
#   "src/reflex/api.py"       = "Interface" # HTTP / protocol boundary
#   "src/reflex/core.py"      = "Core"      # domain logic
#   "src/reflex/models.py"    = "Storage"   # data access
#   "src/reflex/output.py"    = "Output"    # rendering / side effects
#   "src/reflex/config.py"    = "Internal"  # shared utilities

[flow_rules]
# Controls which cross-layer imports are allowed.
# Key: "LayerA -> LayerB". Value: ok | warn | violation.
"Entry -> Interface" = "ok"
"Entry -> Core" = "ok"
"Entry -> Storage" = "ok"
"Entry -> Output" = "ok"
"Entry -> Internal" = "ok"
"Interface -> Core" = "ok"
"Interface -> Storage" = "ok"
"Interface -> Internal" = "ok"
"Core -> Storage" = "ok"
"Core -> Internal" = "ok"
"Output -> Core" = "ok"
"Output -> Internal" = "ok"
"Storage -> Internal" = "ok"
"Core -> Entry" = "violation"
"Core -> Interface" = "violation"
"Core -> Output" = "violation"
"Storage -> Core" = "violation"
"Storage -> Interface" = "violation"
"Storage -> Entry" = "violation"
"Internal -> Core" = "violation"
"Internal -> Interface" = "violation"
"Internal -> Entry" = "violation"
"Internal -> Output" = "violation"
"Output -> Entry" = "violation"
"Output -> Interface" = "violation"
"Interface -> Entry" = "violation"

[intentional_overrides]
# Approved exceptions to flow_rules violations. Each costs 5 pts from the health score.
# Example:
#   "src/reflex/cli.py -> src/reflex/internal.py" = {
#       justification = "bootstrap only — remove after issue #42",
#       approved_by   = "you",
#       date          = "2026-04-25",
#   }
